# Production environment variables.
# Set them in the server's environment (or a .env file next to the app).
# Never commit real values; keep a filled-in copy as .env.production (gitignored).

# --- App -------------------------------------------------------------------
APP_URL=https://www.atice.cloud
# Generate: php artisan key:generate --show
APP_KEY=
LOG_LEVEL=warning
# Required for Philippine time; without them the app runs on UTC.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

# --- Database (mysql service in the same stack) ----------------------------
DB_DATABASE=atice
DB_USERNAME=atice
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Realtime (Pusher Channels, cluster ap1) --------------------------------
# Use "log" until the Pusher app ID + secret are filled in, then "pusher".
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# --- Email (customer login details, "Forgot password?" codes) ---------------
# "log" only writes emails to the log. To really send with a Gmail account:
# turn on 2-Step Verification, create an App Password (myaccount.google.com >
# Security > App passwords), and use it as MAIL_PASSWORD. Gmail sends up to
# about 500 emails a day for free. MAIL_FROM_ADDRESS must be that Gmail address.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AT Ice"
# Customer email check: refuses an email whose account does not exist. Without
# a key the server asks the mail server itself on port 25; many hosts block
# port 25, so set a free QuickEmailVerification key (100 checks a day,
# quickemailverification.com) to keep the check working there.
EMAIL_VERIFY_API_KEY=

# --- Third-party keys -------------------------------------------------------
# Admin dashboard AI summary (https://console.groq.com)
GROQ_API_KEY=
